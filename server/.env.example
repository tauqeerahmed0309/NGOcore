# ==============================================================================
# NGOcore - Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Port (Render / cloud containers automatically set process.env.PORT)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=development

# Allowed Frontend URL for CORS (e.g. https://your-ngo-app.vercel.app in production)
# In development: http://localhost:5173
CLIENT_URL=http://localhost:5173

# ==============================================================================
# Database Configuration (MongoDB Local or MongoDB Atlas)
# ==============================================================================
# Option 1: Local Development MongoDB
# MONGODB_URI=mongodb://127.0.0.1:27017/ngo_records_db
#
# Option 2: MongoDB Atlas Remote Cloud Cluster
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_name>.xxxxx.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ngo_records_db

# ==============================================================================
# Security & JWT Sessions
# ==============================================================================
# JWT secrets (generate a random 32+ character string; never commit real secrets)
JWT_SECRET=replace_with_random_secret_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=7d
JWT_EXPIRES_IN=20m

# File Upload Configuration
MAX_FILE_SIZE_MB=10

# Initial Admin Seed Credentials (used only during database seeding via npm run seed:admin)
ADMIN_EMAIL=admin@ngo.org
ADMIN_PASSWORD=replace_with_a_strong_unique_password

# ==============================================================================
# SMTP Mail Service (For OTP delivery and email verification)
# ==============================================================================
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
MAIL_FROM=NGOcore <no-reply@example.org>

# Google Identity Services OAuth Web Client ID
GOOGLE_CLIENT_ID=replace_with_google_web_client_id

# ==============================================================================
# AI Analytics & Insights Providers (Gemini / Claude Haiku)
# ==============================================================================
# Active AI provider ('auto', 'gemini', 'anthropic', or 'none')
AI_PROVIDER=auto

# Google Gemini API Integration (Stage 3B)
GEMINI_ENABLED=false
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PII_MODE=disabled

# Anthropic Claude Haiku Integration
ANTHROPIC_API_KEY=replace_with_anthropic_api_key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
