# ==============================================================================
# NGOcore - Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Port (Render automatically sets process.env.PORT in production)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=development

# Allowed Frontend URL for CORS (e.g. https://your-ngo-app.vercel.app in production)
# In development: http://localhost:5173
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# Local Development: mongodb://127.0.0.1:27017/ngocore_db
# Production (MongoDB Atlas): mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/ngocore_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ngocore_db

# JWT secrets (generate random values; never reuse examples)
JWT_SECRET=replace_with_random_secret_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# Access token lifetime (15-30 minutes)
JWT_EXPIRES_IN=20m

# File Upload Configuration
MAX_FILE_SIZE_MB=10

# Initial Admin Seed Credentials (used only during database seeding via npm run seed:admin)
ADMIN_EMAIL=admin@ngo.org
ADMIN_PASSWORD=replace_with_a_strong_unique_password

# SMTP email delivery for signup verification (required to deliver OTP messages)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
MAIL_FROM=NGOcore <no-reply@example.org>

# Google Identity Services OAuth Web Client ID (used to verify Google sign-in tokens)
GOOGLE_CLIENT_ID=replace_with_google_web_client_id

# Optional AI-generated dashboard summaries (aggregated statistics only)
ANTHROPIC_API_KEY=replace_with_anthropic_api_key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
