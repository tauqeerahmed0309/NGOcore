# ==========================================
# NGOConnect Production Configuration Template
# ==========================================

# Server Environment
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://mongodb:27017/ngo_management
CLIENT_URL=https://your-ngo-platform.org

# Cryptographic Token Secrets
JWT_ACCESS_SECRET=replace_with_64_char_cryptographically_secure_random_key_1
JWT_REFRESH_SECRET=replace_with_64_char_cryptographically_secure_random_key_2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256 Record Vault Encryption Key (Must be 32 bytes hex / 64 hex characters)
RECORD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Python FastAPI AI Microservice
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_SECRET=secure_shared_secret_between_node_and_fastapi

# Polygon L2 Blockchain Configuration
BLOCKCHAIN_NETWORK=polygon-amoy
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
BLOCKCHAIN_CONTRACT_ADDRESS=0x71C35B91a09D80fD4F72D0fFc29EaAb83b4b84A2
BLOCKCHAIN_PRIVATE_KEY=your_polygon_amoy_relayer_private_key_here

# Cloudinary / AWS S3 File Storage (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM="NGOConnect Security" <security@your-ngo-platform.org>
