# ==============================================================================
# NGOcore — Docker Compose Environment Template (.env.docker.example)
# Copy this file to .env before running: docker compose up -d --build
# NEVER commit actual secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Service Ports & Domain Configuration
# ------------------------------------------------------------------------------
# Port for the frontend Nginx web server accessible from your browser
FRONTEND_PORT=3000

# Port for the backend API service (accessible directly or via reverse proxy)
PORT=5000

# Allowed Frontend Origins for CORS (comma-separated list without trailing slashes)
CLIENT_URL=http://localhost:3000,http://localhost:80,http://127.0.0.1:3000

# Frontend API Base URL (defaults to /api/v1 which routes through Nginx reverse proxy)
VITE_API_URL=/api/v1

# ------------------------------------------------------------------------------
# Database Configuration (Internal Docker Service)
# ------------------------------------------------------------------------------
# Database name inside MongoDB
MONGO_INITDB_DATABASE=ngo_records_db

# MongoDB Connection String (uses the internal 'mongodb' container hostname)
MONGODB_URI=mongodb://mongodb:27017/ngo_records_db

# Optional host port mapping for local database clients (e.g. MongoDB Compass)
# MONGO_PORT=27017

# ------------------------------------------------------------------------------
# Authentication & Security Keys (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Primary JWT signing secret (must be a random, cryptographically secure 32+ character string)
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# JWT session expiry durations
JWT_EXPIRES_IN=20m
JWT_REFRESH_EXPIRES_IN=7d

# File upload limit (in Megabytes)
MAX_FILE_SIZE_MB=10

# Initial Admin bootstrap credentials (used only during initial seed if executed)
ADMIN_EMAIL=admin@ngo.org
ADMIN_PASSWORD=replace_with_a_strong_random_admin_password

# ------------------------------------------------------------------------------
# SMTP Mail Delivery (Optional: used for signup OTP and verification emails)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
MAIL_FROM=NGOcore <no-reply@example.org>

# ------------------------------------------------------------------------------
# OAuth & External Identity Providers (Optional)
# ------------------------------------------------------------------------------
# Google Web Client ID for Google One-Tap / Sign-In
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
VITE_GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id

# ------------------------------------------------------------------------------
# AI Analytics & Data Assistant Integrations (Optional)
# ------------------------------------------------------------------------------
# AI Provider selection: 'auto' | 'gemini' | 'anthropic' | 'none'
AI_PROVIDER=auto

# Google Gemini API Configuration
GEMINI_ENABLED=false
GEMINI_API_KEY=replace_with_google_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PII_MODE=disabled

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=replace_with_anthropic_claude_api_key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
