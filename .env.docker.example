# ==============================================================================
# NGOcore — Docker Compose Environment Template (.env.docker.example)
#
# Instructions:
# 1. Copy this file to .env in the repository root:
#    cp .env.docker.example .env
# 2. Generate and set a secure 32+ character JWT_SECRET:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Start the stack:
#    docker compose up -d --build
#
# NEVER commit your actual .env file or real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ports & Networking (Defaults are production-ready)
# ------------------------------------------------------------------------------
# Host port mapping for frontend Nginx web server (browser entry point)
FRONTEND_PORT=3000

# Backend Express API port (internal to container; mapped to host port 5000)
PORT=5000

# Allowed Frontend Origins for CORS (comma-separated list without trailing slashes)
# In Docker, Nginx proxies /api traffic same-origin from port 3000
CLIENT_URL=http://localhost:3000,http://localhost:80,http://127.0.0.1:3000,http://localhost:5000

# Frontend API Base URL (passed to client build; /api/v1 routes through Nginx reverse proxy)
VITE_API_URL=/api/v1

# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB Atlas Cloud Cluster)
# ------------------------------------------------------------------------------
# MANDATORY: MongoDB Atlas connection string with credentials and database name.
# Obtain from MongoDB Atlas Dashboard -> Connect -> Drivers -> Connection String.
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ngocore_db?retryWrites=true&w=majority
#
# IMPORTANT ATLAS PRE-FLIGHT REQUIREMENTS:
# 1. Atlas Network Access: Whitelist your host IP or allow 0.0.0.0/0 for testing.
# 2. Atlas Database User: Ensure the user has readWriteAnyDatabase or readWrite@ngocore_db privileges.
# 3. Target Database: Specify the database name in the path (e.g. /ngocore_db).
# 4. Do NOT use localhost or 127.0.0.1 in Docker Compose (containers communicate via external DNS).
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ngocore_db?retryWrites=true&w=majority

# Optional: If running the local database container profile (docker compose --profile local-db up):
# MONGO_INITDB_DATABASE=ngo_records_db

# ------------------------------------------------------------------------------
# 3. Security & Authentication (MANDATORY)
# ------------------------------------------------------------------------------
# JWT signing secret (REQUIRED: must be at least 32 characters long)
# Generate with: openssl rand -base64 32   OR
#                node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Docker Compose will refuse to start if this is unset or empty.
JWT_SECRET=

# Access token lifespan (must be between 15m and 30m)
JWT_EXPIRES_IN=20m

# Refresh token lifespan (must be between 1d and 30d)
JWT_REFRESH_EXPIRES_IN=7d

# File storage provider: 'local' (mounted volumes) or 's3' (cloud bucket)
STORAGE_PROVIDER=local

# Maximum allowed upload file size in Megabytes (1 to 100)
MAX_FILE_SIZE_MB=10

# Initial Admin bootstrap credentials (used for initial platform setup)
ADMIN_EMAIL=admin@ngo.org
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Email / SMTP Configuration (OPTIONAL)
# ------------------------------------------------------------------------------
# Leave all SMTP fields EMPTY if email delivery is not required.
# If configured, SMTP_HOST, MAIL_FROM, SMTP_USER, and SMTP_PASSWORD must all be set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 / One-Tap Authentication (OPTIONAL)
# ------------------------------------------------------------------------------
# Leave EMPTY if not using Google Sign-In.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 6. AI Analytics & Intelligent Assistant (OPTIONAL)
# ------------------------------------------------------------------------------
# AI Provider selection: 'auto' | 'gemini' | 'anthropic' | 'none'
# When set to 'auto' or 'none' with empty keys, NGOcore cleanly uses deterministic
# rule-based reporting without making external API calls.
#
# IMPORTANT: Leave API keys EMPTY unless you have real credentials.
# Fake placeholders will be rejected by provider APIs and cause validation errors.
AI_PROVIDER=auto

# Google Gemini API (Optional)
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PII_MODE=disabled

# Anthropic Claude API (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
