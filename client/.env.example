# ==============================================================================
# NGOcore - Client Environment Configuration (.env.example)
# ==============================================================================

# Backend API Base URL
# Local Development: http://localhost:5000/api/v1
# Production (Render): https://<your-render-backend-name>.onrender.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# Google Identity Services OAuth Web Client ID (must match server GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=replace_with_google_web_client_id
